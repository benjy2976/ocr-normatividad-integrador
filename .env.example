# Copiar a .env y completar. docker-compose.yml lee estas variables; el valor
# que se indica en cada una es el default que aplica si se omite.
#
# Las variables comentadas (#) son opcionales: descomentar solo para cambiar el
# default. Los flags de funcionalidad nacen apagados; el orden de activacion
# esta en docs/operacion-ocr-reproceso.md.

# ── Normatividad (adaptador) ─────────────────────────────────────────
NORMATIVIDAD_BASE_URL=http://munis:8000
# Debe coincidir con OCR_SERVICE_TOKEN del .env de Munis.
NORMATIVIDAD_OCR_TOKEN=

# Timeouts de las llamadas a Normatividad (callbacks y descarga del PDF fuente).
#OCR_CALLBACK_TIMEOUT_SECONDS=30
#OCR_DOWNLOAD_TIMEOUT_SECONDS=120

# Reintentos ante errores de red o respuestas 429/5xx de Normatividad.
#OCR_HTTP_MAX_RETRIES=6
#OCR_HTTP_RETRY_BASE_SECONDS=2
#OCR_HTTP_RETRY_MAX_SECONDS=60
# "true" registra en el log cada peticion HTTP a Normatividad (diagnostico).
#OCR_HTTP_DEBUG=false

# ── ocr-core ─────────────────────────────────────────────────────────
# Interno: URL de ocr-core dentro de la red grh_network. En el despliegue
# actual el contenedor se llama "core-ocr".
OCR_CORE_URL=http://core-ocr:8000

# Espera maxima por job y frecuencia de consulta de su estado.
#OCR_CORE_JOB_TIMEOUT_SECONDS=1800
#OCR_CORE_JOB_POLL_INTERVAL_SECONDS=2
# Timeout de cada peticion HTTP al core.
#OCR_CORE_HTTP_TIMEOUT_SECONDS=30
# Cuanto tiempo se recuerda lo que anuncia /meta (capacidades) antes de volver a consultarlo.
#OCR_CORE_META_TTL_SECONDS=60
# Reintentos de POST /jobs; solo se usan con clave idempotente, asi que no duplican OCR.
#OCR_CORE_SUBMIT_MAX_RETRIES=2

# ── Funcionalidades (reproceso y trazabilidad) ───────────────────────
# Obedece reprocess_artifacts de Normatividad: rehace los artefactos pedidos
# aunque ya existan en cache (overwrite=true solo para esos). Es la otra mitad
# de OCR_FORCE_REPROCESS_ENABLED del .env de Munis.
OCR_FORCE_REPROCESS_ENABLED=false
# Reenvia a Normatividad la version, host y metricas por pagina de cada ejecucion.
# Requiere un core que publique telemetry_schema y execution_provenance (0.4.0+).
OCR_TELEMETRY_FORWARD_ENABLED=false
# Ante un PDF con texto util pide pdf_on_skip=reuse: no copia el PDF al cache y
# Normatividad usa el original. Requiere pdf_on_skip_reuse en el core (0.4.0+).
OCR_SOURCE_REUSE_ENABLED=false
# "true" exige consultar /meta siempre, aunque ningun flag lo requiera.
#OCR_CORE_CAPABILITIES_REQUIRED=false
# Renueva el lease durante jobs largos. Encender antes que
# OCR_PROCESSING_LEASE_RECOVERY_ENABLED en Munis.
#OCR_QUEUE_HEARTBEAT_ENABLED=false
#OCR_QUEUE_HEARTBEAT_SECONDS=60

# ── Core shadow (piloto comparativo, no autoritativo) ────────────────
# El NFS se usa como entrada; los destinos pertenecen al volumen privado
# montado exclusivamente por el core shadow.
OCR_SHADOW_ENABLED=false
OCR_SHADOW_CORE_URL=http://core-ocr:8000
OCR_SHADOW_OUTPUT_ROOT=/shadow-cache/review
#OCR_SHADOW_SUBMIT_TIMEOUT_SECONDS=30

# ── Worker ───────────────────────────────────────────────────────────
# Interruptor real de operacion del worker - independiente de cuantas
# replicas tenga el ocr-worker de Kubernetes. Si este flag esta en "true"
# y NORMATIVIDAD_BASE_URL apunta a produccion, el worker empieza a
# consumir la cola real apenas arranca el contenedor. Dejar en "false"
# para levantar el contenedor sin que opere (por ejemplo, para pruebas
# puntuales via `docker compose run ... worker_main.py once`, que no depende de
# este flag).
OCR_WORKER_ENABLED=true
# Política Docker del contenedor. Usar "no" junto con
# OCR_WORKER_ENABLED=false para impedir el autoarranque y el consumo de cola.
OCR_WORKER_RESTART_POLICY=unless-stopped
# Nombre del worker: Normatividad lo usa como propietario del lease.
OCR_WORKER_NAME=normatividad-worker-1
OCR_WORKER_CONCURRENCY=2
OCR_POLL_INTERVAL_SECONDS=10
# Errores consecutivos de pull-next antes de detener el worker.
#OCR_WORKER_MAX_CONSECUTIVE_ERRORS=20
#OCR_WORKER_LOG_LEVEL=INFO
# OCR_SHARED_CACHE_DIR no se configura aqui: docker-compose.yml lo fija en
# /nfs-cache, acoplado al volumen NFS montado en el contenedor.

# ── Busqueda ─────────────────────────────────────────────────────────
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INDEX=munis_ocr_pages
#OPENSEARCH_TIMEOUT_SECONDS=30
#OPENSEARCH_MAX_RETRIES=3
# Solo se aplican al crear el indice.
#OPENSEARCH_SHARDS=1
#OPENSEARCH_REPLICAS=0
SEARCH_INDEXER_POLL_INTERVAL_SECONDS=300
SEARCH_INDEXER_BATCH_SIZE=500
SEARCH_INDEXER_LOG_LEVEL=INFO
