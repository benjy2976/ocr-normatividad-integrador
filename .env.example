# ── Normatividad (adaptador) ─────────────────────────────────────────
NORMATIVIDAD_BASE_URL=http://munis:8000
NORMATIVIDAD_OCR_TOKEN=

# Interno: URL de ocr-core dentro de la red grh_network. El nombre del
# servicio en ocr-core/docker-compose.yml es "ocr-core" - alineado a
# proposito con el nombre del repo.
OCR_CORE_URL=http://ocr-core:8000

# Interruptor real de operacion del worker - independiente de cuantas
# replicas tenga el ocr-worker de Kubernetes. Si este flag esta en "true"
# y NORMATIVIDAD_BASE_URL apunta a produccion, el worker empieza a
# consumir la cola real apenas arranca el contenedor. Dejar en "false"
# para levantar el contenedor sin que opere (por ejemplo, para pruebas
# puntuales via `docker run ... worker_main.py once`, que no depende de
# este flag).
OCR_WORKER_ENABLED=true

OCR_WORKER_NAME=normatividad-worker-1
OCR_WORKER_CONCURRENCY=1
OCR_POLL_INTERVAL_SECONDS=10

# ── Busqueda ──────────────────────────────────────────────────────────
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INDEX=munis_ocr_pages
SEARCH_INDEXER_POLL_INTERVAL_SECONDS=300
SEARCH_INDEXER_BATCH_SIZE=500
SEARCH_INDEXER_LOG_LEVEL=INFO
